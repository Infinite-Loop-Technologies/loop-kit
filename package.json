{
    "private": true,
    "workspaces": [
        "packages/*",
        "apps/*"
    ],
    "scripts": {
        "setup": "proto install --yes && bun install",
        "setup:tools": "proto install --yes",
        "build": "bun tools/workspace.ts build",
        "typecheck:bun": "bun x tsc -p tsconfig.bun.json",
        "typecheck": "bun run typecheck:bun && bun tools/workspace.ts typecheck",
        "test": "bun test",
        "check": "bun run typecheck && bun run test",
        "ci": "bun run build && bun run typecheck && bun run test",
        "forge:dev": "bun run --cwd apps/forge dev",
        "dock:dev": "bun run --cwd apps/dock-demo dev",
        "loom:dev": "bun run --cwd apps/loom-demo dev",
        "workspaces:list": "bun tools/workspace.ts list"
    },
    "devDependencies": {
        "@types/bun": "^1.3.11",
        "typescript": "^5.9.3"
    },
    "packageManager": "bun@1.3.11",
    "engines": {
        "bun": "1.3.11",
        "node": "~22"
    }
}
