{
    "private": true,
    "scripts": {
        "setup:tools": "proto install --yes",
        "build": "proto run moon -- run :build",
        "ci": "proto run moon -- ci :build :typecheck :test",
        "forge:dev": "node tools/forge-dev/stack.mjs up",
        "forge:dev:plan": "node tools/forge-dev/stack.mjs plan",
        "lint": "proto run moon -- run :lint",
        "exp:oci-lab": "cargo run --manifest-path experiments/oci-lab/Cargo.toml --",
        "typecheck": "proto run moon -- run :typecheck",
        "test": "proto run moon -- run :test",
        "release:patch": "pnpm -r version patch",
        "release:minor": "pnpm -r version minor"
    },
    "devDependencies": {
        "typescript": "^5.9.3"
    },
    "packageManager": "pnpm@10.15.1",
    "engines": {
        "node": "~22"
    }
}
