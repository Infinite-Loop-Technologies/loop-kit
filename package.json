{
    "private": true,
    "scripts": {
        "setup:tools": "proto install --yes",
        "build": "proto run moon -- run :build",
        "ci": "proto run moon -- ci :build :typecheck :test",
        "lint": "proto run moon -- run :lint",
        "loop": "pnpm run loop:stable",
        "loop:stable": "pnpm dlx @loop-kit/loop-cli@0.1.0",
        "loop:version": "node -e \"const s=require('./package.json').scripts['loop:stable']; const m=s.match(/@loop-kit\\/loop-cli@([^\\s\\\"]+)/); if(!m){console.error('Unable to parse loop:stable pin'); process.exit(1);} console.log(m[0]);\"",
        "loop:dev": "node packages/loop-cli/dist/cli.js",
        "loop:local": "pnpm run loop:dev",
        "loop:smoke": "node tools/release/loop-smoke.mjs",
        "release:publish:all": "node tools/release/publish-all.mjs",
        "release:publish:all:dry": "node tools/release/publish-all.mjs --dry-run",
        "release:publish:all:env": "proto run dotenvx -- run --env-file .env.release -- node tools/release/publish-all.mjs",
        "release:publish:cli": "node tools/release/publish-loop-cli-stack.mjs",
        "release:publish:cli:dry": "node tools/release/publish-loop-cli-stack.mjs --dry-run",
        "release:publish:cli:env": "proto run dotenvx -- run --env-file .env.release -- node tools/release/publish-loop-cli-stack.mjs",
        "verify:web-app": "node tools/dev/verify-web-app.mjs",
        "test:dev-tools": "node --test ./tools/dev/test/**/*.test.mjs",
        "typecheck": "proto run moon -- run :typecheck",
        "test": "proto run moon -- run :test",
        "release:patch": "pnpm -r version patch",
        "release:minor": "pnpm -r version minor"
    },
    "devDependencies": {
        "typescript": "^5.9.3"
    },
    "packageManager": "pnpm@10.15.1",
    "engines": {
        "node": "~22"
    }
}
