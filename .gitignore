# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.
# Node.js dependencies
**/node_modules/
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
**/.next/
/shadcn-registry/.next
/out/

# production
/build
/dist
**/dist/
**/.output/
**/.swc/
**/target/
**/tmp/
**/src-tauri/target/
**/src-tauri/gen/
**/src-tauri/icons/android/
**/src-tauri/icons/ios/
apps/workbench/dist/

# misc
.DS_Store
*.pem
*.bun-build

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env files (can opt-in for committing if needed)
.env*
!.env*.example
!**/.env*.example

# vercel
.vercel

# root-level Volt daemon/runtime state
/.volt/
**/.volt/

# typescript
*.tsbuildinfo
next-env.d.ts

# stash
/vault

# local CKB artifacts
.ckb/
index.scip

# local workflow artifacts
**/.workflow-data/

# loop auth material
loop/auth.json

# loop package build artifacts
packages/loop-cli/dist/
packages/loop-kernel/dist/
packages/loop-contracts/dist/
packages/loopd/dist/
packages/loop-mcp/dist/
packages/loop-ai/dist/
packages/contracts/.openapi-ts.lock
