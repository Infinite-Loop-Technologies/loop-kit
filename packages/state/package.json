{
    "name": "@loop-kit/state",
    "version": "0.1.0",
    "description": "Patch-based state primitives, history helpers, and React store bindings.",
    "type": "module",
    "sideEffects": false,
    "main": "./src/index.ts",
    "module": "./src/index.ts",
    "types": "./src/index.ts",
    "exports": {
        ".": {
            "types": "./src/index.ts",
            "import": "./src/index.ts",
            "default": "./src/index.ts"
        },
        "./react": {
            "types": "./src/index-react.ts",
            "import": "./src/index-react.ts",
            "default": "./src/index-react.ts"
        },
        "./package.json": "./package.json"
    },
    "files": ["src", "README.md", "UPSTREAM.md"],
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "clean": "bun -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true });\"",
        "test": "bun test",
        "prepack": "bun run clean && bun run build"
    },
    "peerDependencies": {
        "react": "^18.2.0 || ^19.0.0",
        "react-dom": "^18.2.0 || ^19.0.0"
    },
    "devDependencies": {
        "@types/react": "^19.2.2",
        "@types/react-dom": "^19.2.2",
        "typescript": "^5.9.3"
    },
    "license": "MIT"
}
