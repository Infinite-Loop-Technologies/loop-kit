{
    "name": "@loop-kit/loom-core",
    "version": "0.1.0",
    "description": "Headless Loom contracts for blueprints, tokens, themes, recipes, and resolved styles.",
    "type": "module",
    "sideEffects": false,
    "main": "./src/index.ts",
    "module": "./src/index.ts",
    "types": "./src/index.ts",
    "exports": {
        ".": {
            "types": "./src/index.ts",
            "import": "./src/index.ts",
            "default": "./src/index.ts"
        },
        "./package.json": "./package.json"
    },
    "files": ["src", "README.md"],
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "clean": "bun -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true });\"",
        "test": "bun test",
        "prepack": "bun run clean && bun run build"
    },
    "dependencies": {
        "zod": "^3.25.76"
    },
    "devDependencies": {
        "typescript": "^5.9.3"
    }
}
