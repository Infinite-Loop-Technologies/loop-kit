{
  "name": "@loop-kit/forge-contracts",
  "version": "0.1.0",
  "description": "Forge control-plane contracts, generated types, and client SDK.",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "openapi",
    "asyncapi",
    "README.md"
  ],
  "scripts": {
    "validate:openapi": "redocly lint openapi/openapi.yaml",
    "validate:asyncapi": "node ./scripts/validate-asyncapi.mjs",
    "validate": "pnpm run validate:openapi && pnpm run validate:asyncapi",
    "generate": "pnpm exec openapi-ts",
    "check:generated": "node ./scripts/check-generated.mjs",
    "build": "pnpm run validate && pnpm run generate && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm run validate && pnpm run check:generated && node --import tsx --test ./test/**/*.test.ts",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\""
  },
  "dependencies": {
    "@hey-api/client-fetch": "^0.13.1"
  },
  "devDependencies": {
    "@asyncapi/parser": "^3.6.0",
    "@hey-api/openapi-ts": "^0.94.0",
    "@redocly/cli": "^2.21.0",
    "@types/node": "^22.17.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
