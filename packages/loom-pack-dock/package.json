{
    "name": "@loop-kit/loom-pack-dock",
    "version": "0.1.0",
    "description": "Loom dock workbench and React UI built on top of @loop-kit/dock.",
    "type": "module",
    "sideEffects": false,
    "main": "./src/index.ts",
    "module": "./src/index.ts",
    "types": "./src/index.ts",
    "exports": {
        ".": {
            "types": "./src/index.ts",
            "import": "./src/index.ts",
            "default": "./src/index.ts"
        },
        "./package.json": "./package.json"
    },
    "files": ["src", "README.md"],
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "clean": "bun -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true });\"",
        "test": "bun test",
        "prepack": "bun run clean && bun run build"
    },
    "dependencies": {
        "@loop-kit/dock": "workspace:*",
        "@loop-kit/interaction": "workspace:*",
        "@loop-kit/interaction-react": "workspace:*",
        "@loop-kit/loom-react": "workspace:*",
        "lucide-react": "^0.487.0"
    },
    "peerDependencies": {
        "react": "^18.2.0 || ^19.0.0",
        "react-dom": "^18.2.0 || ^19.0.0"
    },
    "devDependencies": {
        "@types/react": "^19.2.2",
        "@types/react-dom": "^19.2.2",
        "typescript": "^5.9.3"
    }
}
