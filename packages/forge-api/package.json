{
  "name": "@loop-kit/forge-api",
  "version": "0.1.0",
  "description": "Forge Fastify control-plane API foundation with Neon and Drizzle.",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "drizzle", "README.md"],
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "pnpm --filter @loop-kit/forge-contracts build && tsc -p tsconfig.build.json",
    "typecheck": "pnpm --filter @loop-kit/forge-contracts build && tsc -p tsconfig.json --noEmit",
    "test": "pnpm --filter @loop-kit/forge-contracts build && pnpm run db:check && node --import tsx --test ./test/**/*.test.ts",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config drizzle.config.ts",
    "db:check": "drizzle-kit check --config drizzle.config.ts",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\""
  },
  "dependencies": {
    "@loop-kit/forge-contracts": "workspace:*",
    "@neondatabase/serverless": "^1.0.2",
    "drizzle-orm": "^0.45.1",
    "fastify": "^5.8.2",
    "fastify-plugin": "^5.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.17.0",
    "drizzle-kit": "^0.31.9",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
