{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "ESM for browsers and Node16+",
  "extends": "./base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["dom", "esnext"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "es2022",

    "outDir": "dist",
    "rootDir": ".",
    "types": ["node"],
    "resolveJsonModule": true,
    "tsBuildInfoFile": "dist/.tsBuildInfo"
  },
  "include": [
    "src",
    "test",
    "test/_webSocketTestServerControl.ts",
    "vitest.*.config.ts"
  ],
  "exclude": ["dist", "node_modules"]
}
