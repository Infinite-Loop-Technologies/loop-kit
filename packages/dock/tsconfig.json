{
    "compilerOptions": {
        "target": "ES2022",
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "jsx": "react-jsx",
        "types": ["node", "react"],
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "strict": true,
        "declaration": true,
        "declarationMap": true,
        "sourceMap": true,
        "outDir": "dist",
        "rootDir": ".",
        "skipLibCheck": true
    },
    "include": [
        "src/index.ts",
        "src/store.ts",
        "src/v2/controller.ts",
        "src/v2/model.ts",
        "src/v2/result.ts",
        "src/v2/types.ts"
    ]
}
