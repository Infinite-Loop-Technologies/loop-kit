{
  "name": "volt",
  "version": "0.4.0",
  "type": "module",
  "description": "A Bun-first metaframework for orchestrating multi-target apps.",
  "bin": {
    "volt": "./bin/volt.js"
  },
  "exports": {
    ".": "./src/index.ts",
    "./bun": "./src/plugins/bun/index.ts",
    "./builtins": "./src/builtins.ts",
    "./cli": "./src/cli.ts",
    "./contracts": "./src/schema.ts",
    "./entrypoint": "./src/entrypoint.ts",
    "./flow": "./src/flow.ts",
    "./workspace": "./src/workspace.ts"
  },
  "files": [
    "bin",
    "dist",
    "src"
  ],
  "scripts": {
    "build": "bun run build:package",
    "build:package": "bun build ./src/index.ts ./src/cli.ts --outdir ./dist --target bun --format esm",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "bun run typecheck"
  },
  "devDependencies": {
    "@bytecodealliance/jco": "^1.15.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "x-publish": true
}
