{
  "name": "volt",
  "version": "0.4.0",
  "type": "module",
  "description": "A Bun-first metaframework for orchestrating multi-target apps.",
  "bin": {
    "volt": "./bin/volt.js"
  },
  "exports": {
    ".": "./src/index.ts",
    "./bun": "./src/plugins/bun/index.ts",
    "./builtins": "./src/builtins.ts",
    "./cli": "./src/cli.ts",
    "./codegen": "./src/codegen.ts",
    "./contracts": "./src/schema.ts",
    "./dashboard": "./src/dashboard.tsx",
    "./electrobun": "./src/electrobun.ts",
    "./entrypoint": "./src/entrypoint.ts",
    "./flow": "./src/flow.ts",
    "./workspace": "./src/workspace.ts"
  },
  "files": [
    "bin",
    "dist",
    "src"
  ],
  "scripts": {
    "build": "bun run build:package",
    "build:package": "bun build ./src/index.ts ./src/cli.ts ./src/dashboard.tsx --outdir ./dist --target bun --format esm",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "bun run typecheck"
  },
  "dependencies": {
    "@loop-kit/common": "workspace:*",
    "@loop-kit/interaction": "workspace:*",
    "@loop-kit/state": "workspace:*",
    "@opentui/core": "^0.1.97",
    "@opentui/react": "^0.1.97",
    "@opentui-ui/dialog": "^0.1.2",
    "@opentui-ui/toast": "^0.0.5",
    "@parcel/watcher": "^2.5.6",
    "oxc-parser": "^0.124.0",
    "react": "^19.2.5",
    "recast": "^0.23.11",
    "ts-morph": "^27.0.2"
  },
  "devDependencies": {
    "@bytecodealliance/jco": "^1.15.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "x-publish": true
}
