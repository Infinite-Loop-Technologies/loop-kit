{
    "name": "@loop-kit/loom-theme-aquatic-react",
    "version": "0.1.0",
    "description": "Aquatic Loom React theme with glossy translucent surfaces.",
    "type": "module",
    "sideEffects": false,
    "main": "./src/index.tsx",
    "module": "./src/index.tsx",
    "types": "./src/index.tsx",
    "exports": {
        ".": {
            "types": "./src/index.tsx",
            "import": "./src/index.tsx",
            "default": "./src/index.tsx"
        },
        "./package.json": "./package.json"
    },
    "files": ["src", "README.md"],
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "clean": "bun -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true });\"",
        "prepack": "bun run clean && bun run build"
    },
    "dependencies": {
        "@loop-kit/loom-core": "workspace:*",
        "@loop-kit/loom-react": "workspace:*"
    },
    "peerDependencies": {
        "react": "^18.2.0 || ^19.0.0",
        "react-dom": "^18.2.0 || ^19.0.0"
    },
    "devDependencies": {
        "@types/react": "^19.2.2",
        "react": "19.2.5",
        "react-dom": "19.2.5",
        "typescript": "^5.9.3"
    }
}
