{
    "name": "@loop-kit/graphite",
    "version": "0.1.0",
    "description": "Lightweight intent-driven graph runtime with reactive query + mutation DSL.",
    "type": "module",
    "sideEffects": false,
    "main": "./src/index.ts",
    "module": "./src/index.ts",
    "types": "./src/index.ts",
    "exports": {
        ".": {
            "types": "./src/index.ts",
            "import": "./src/index.ts",
            "default": "./src/index.ts"
        },
        "./react": {
            "types": "./src/react.tsx",
            "import": "./src/react.tsx",
            "default": "./src/react.tsx"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "src",
        "README.md"
    ],
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
        "prepack": "pnpm run clean && pnpm run build"
    },
    "peerDependencies": {
        "react": "^18.2.0 || ^19.0.0",
        "react-dom": "^18.2.0 || ^19.0.0"
    },
    "devDependencies": {
        "@types/react": "^19.1.2",
        "@types/react-dom": "^19.1.2",
        "typescript": "^5.9.3"
    },
    "keywords": [
        "graph",
        "state",
        "reactive",
        "intent",
        "dsl"
    ],
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/Infinite-Loop-Technologies/design-system.git",
        "directory": "packages/graphite"
    }
}
