{
    "name": "@loop-kit/graphite",
    "version": "0.1.0",
    "description": "Lightweight intent-driven graph runtime with reactive query, mutation, connector, and persistence primitives.",
    "type": "module",
    "sideEffects": false,
    "main": "./src/index.ts",
    "module": "./src/index.ts",
    "types": "./src/index.ts",
    "exports": {
        ".": {
            "types": "./src/index.ts",
            "import": "./src/index.ts",
            "default": "./src/index.ts"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "src",
        "README.md"
    ],
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "clean": "bun -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true });\"",
        "prepack": "bun run clean && bun run build"
    },
    "devDependencies": {
        "typescript": "^5.9.3"
    },
    "keywords": [
        "graph",
        "state",
        "reactive",
        "intent",
        "dsl"
    ],
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/Infinite-Loop-Technologies/design-system.git",
        "directory": "packages/graphite"
    }
}
