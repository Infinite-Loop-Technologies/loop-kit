{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "Forge Desktop",
    "version": "0.1.0",
    "identifier": "com.infinite-loop-technologies.forge",
    "build": {
        "beforeDevCommand": "pnpm run dev:web",
        "beforeBuildCommand": "pnpm run build:web",
        "devUrl": "http://localhost:1420",
        "frontendDist": "../dist"
    },
    "app": {
        "withGlobalTauri": false,
        "security": {
            "csp": null,
            "capabilities": ["default"]
        },
        "windows": [
            {
                "label": "main",
                "title": "Forge",
                "width": 1440,
                "height": 900,
                "minWidth": 1100,
                "minHeight": 720,
                "resizable": true
            }
        ]
    },
    "bundle": {
        "active": true,
        "targets": "all"
    }
}
